# ATMOS — Umbra & Solana Environment Configuration
# ═════════════════════════════════════════════════════════════════

# ─── Solana Network ─────────────────────────────────────────────
# Network: devnet (for hackathon), testnet/mainnet-beta (production)
SOLANA_NETWORK=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_COMMITMENT=confirmed

# ─── Umbra SDK Configuration ────────────────────────────────────
# Program IDs (mainnet/devnet-specific)
UMBRA_PROGRAM_ID=UmbraXVgJftArwTb2NXfXHU3FeWQ4g8ViPrxjMvG

# Your server's Solana keypair (base58-encoded private key)
# ⚠️  CRITICAL: NEVER commit this to git. Use vault/secrets manager in production.
# Generate: solana keygen new (save to environment only)
SOLANA_WALLET_PRIVATE_KEY=

# Optional: Account used to collect Umbra transaction fees
# Leave blank to use SOLANA_WALLET_PRIVATE_KEY
UMBRA_FEE_COLLECTOR_WALLET=

# ─── SPL Token Configuration ────────────────────────────────────
# Standard carbon credit token settings
SPL_TOKEN_DECIMALS=6
SPL_TOKEN_NAME=Atmos Carbon Credits
SPL_TOKEN_SYMBOL=ACC

# ─── Privacy Settings ────────────────────────────────────────────
# Viewing key expiry (days until a viewing key expires)
VIEWING_KEY_EXPIRY_DAYS=365

# Determine storage method for viewing keys
# Options: 'database' (hashed), 'wallet' (user-controlled)
VIEWING_KEY_STORAGE=database

# ─── Encryption Settings ────────────────────────────────────────
# Optional: custom JWT secret for key derivation (if Umbra SDK unavailable)
JWT_SECRET=your-super-secret-key-change-in-production

# ─── Database Configuration ────────────────────────────────────
# PostgreSQL connection for umbra_transfers, umbra_viewing_keys tables
DATABASE_URL=postgresql://postgres:password@localhost:5432/atmos
DB_POOL_MIN=2
DB_POOL_MAX=20

# ─── Dodo Payments (Public Fallback) ────────────────────────────
# For users who don't want private transfers
DODO_API_KEY=
DODO_CHECKOUT_URL=https://test.checkout.dodopayments.com
DODO_WEBHOOK_SECRET=

# ─── Logging Configuration ────────────────────────────────────
LOG_LEVEL=debug
AUDIT_LOG_ENABLED=true
AUDIT_LOG_FILE=/var/log/atmos/audit.log

# ─── Rate Limiting ──────────────────────────────────────────────
# Prevent brute force attempts to guess viewing keys
RATE_LIMIT_VIEWING_KEY_ATTEMPTS=5
RATE_LIMIT_VIEWING_KEY_WINDOW_MINS=15

# ─── Server Configuration ────────────────────────────────────────
PORT=9001
NODE_ENV=development
CORS_ORIGIN=http://localhost:8081,http://localhost:3000,http://localhost:19006

# ─── Mobile Client Configuration ────────────────────────────────
# Expo app communication
EXPO_PUBLIC_API_URL=http://localhost:9001
EXPO_PUBLIC_AUTH_REDIRECT_URL=atmosexample://auth/callback

# ─── Feature Flags ──────────────────────────────────────────────
FEATURE_UMBRA_ENABLED=true
FEATURE_PRIVATE_TRANSFERS=true
FEATURE_COMPLIANCE_REPORTS=true
FEATURE_VIEWING_KEYS=true

# ─── Hackathon Submission ────────────────────────────────────────
# Track submission details
HACKATHON_TRACK=umbra-sdk
HACKATHON_TEAM=Atmos
HACKATHON_SUBMISSION_ID=
HACKATHON_DEADLINE=2024-02-15

# ═════════════════════════════════════════════════════════════════
# SETUP INSTRUCTIONS:
# ═════════════════════════════════════════════════════════════════
#
# 1. Copy this file to: app/api-server/.env.local
#
# 2. Generate your Solana keypair:
#    solana keygen new --no-bip39-passphrase
#    (This creates ~/.config/solana/id.json)
#
# 3. Encode keypair as base58:
#    cat ~/.config/solana/id.json | jq -r '.[0:32] | @base64'
#    cat ~/.config/solana/id.json | jq -r '@base64' | openssl base64 -d | xxd -p -c32 | tr -d ' \n' | base58
#    (Or use: solana config get)
#
# 4. Get wallet address:
#    solana config get pubkey
#    (Set this as SOLANA_WALLET_ADDRESS in auth system)
#
# 5. Request testnet SOL:
#    solana airdrop 5 --url devnet
#    (Repeat as needed)
#
# 6. Install Umbra SDK:
#    pnpm add @umbra-privacy/sdk
#
# 7. Initialize database:
#    pnpm migrate:latest
#
# 8. Start server:
#    pnpm dev
#
# 9. Test private transfer:
#    curl -X POST http://localhost:9001/api/payments/carbon-purchase \
#      -H 'Authorization: Bearer <jwt_token>' \
#      -H 'Content-Type: application/json' \
#      -d '{"projectId":"uuid","quantity":10,"paymentMethod":"umbra-private"}'
#
# ═════════════════════════════════════════════════════════════════
