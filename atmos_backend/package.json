    "@fastify/rate-limit": "^10.3.0",
    "@project-serum/anchor": "^0.26.0",
    "@sentry/node": "^10.53.1",
    "@solana/spl-token": "^0.4.14",
    "@solana/web3.js": "^1.98.4",
    "@supabase/supabase-js": "^2.105.3",
    "axios": "^1.7.9",
    "bs58": "^6.0.0",
    "bull": "^4.16.5",
    "dotenv": "^16.4.5",
    "fastify": "^5.3.2",
    "fastify-plugin": "^5.0.1",
