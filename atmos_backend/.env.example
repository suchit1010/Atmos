# Server
PORT=3000
NODE_ENV=development

# Supabase (Auth + DB)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-key

# PostgreSQL Direct (for PostGIS)
DATABASE_URL=postgresql://postgres:password@localhost:5432/karta
DATABASE_POOL_SIZE=10

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
JWT_REFRESH_SECRET=your-refresh-secret-key-min-32-chars
JWT_EXPIRY=900
JWT_REFRESH_EXPIRY=604800

# Twilio (SMS OTP)
TWILIO_ACCOUNT_SID=ACxxx
TWILIO_AUTH_TOKEN=xxx
TWILIO_PHONE_NUMBER=+1234567890

# Google Earth Engine / Sentinel-2
GEE_PROJECT_ID=your-gee-project
GEE_SERVICE_ACCOUNT=your-service-account@project.iam.gserviceaccount.com
GEE_PRIVATE_KEY_PATH=./keys/gee-service-account.json
STAC_API_URL=https://earth-search.aws.element84.com/v1
SENTINEL_HUB_INSTANCE_ID=your-sentinel-hub-id
SENTINEL_HUB_CLIENT_ID=your-client-id
SENTINEL_HUB_CLIENT_SECRET=your-client-secret

# AI Service (self-hosted FastAPI or external)
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_API_KEY=internal-api-key

# ZK Proof (Light Protocol on Solana)
ZK_CIRCUIT_PATH=./circuits/carbon_mrv.r1cs
ZK_PROVING_KEY_PATH=./circuits/carbon_mrv_0001.zkey
ZK_VERIFICATION_KEY_PATH=./circuits/verification_key.json

# Solana
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_WALLET_PRIVATE_KEY=your-base58-private-key
SOLANA_PROGRAM_ID=KARTAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SPL_TOKEN_DECIMALS=6

# Dodo Payments
DODO_API_KEY=live_xxx
DODO_WEBHOOK_SECRET=whsec_xxx
DODO_API_URL=https://api.dodopayments.com/v1

# S3 / Storage
AWS_REGION=ap-south-1
AWS_BUCKET_NAME=karta-media-production
AWS_ACCESS_KEY_ID=xxx
AWS_SECRET_ACCESS_KEY=xxx

# Rate Limiting
RATE_LIMIT_MAX=1000
RATE_LIMIT_WINDOW=60000

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# CORS
ALLOWED_ORIGINS=http://localhost:19006,https://app.karta.pro
