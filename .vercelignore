# Exclude dependencies
node_modules
.pnpm-store

# Exclude development files
.git
*.log
.DS_Store

# Exclude documentation & tests
test/
docs/
scripts/
.env.local
.env.*.local
**/*.test.ts
**/*.spec.ts
**/*.test.js
**/*.spec.js

# Exclude large non-essential directories
app/mobile/
# app/mockup-sandbox/ is the frontend — do NOT exclude it

# NOTE: Do NOT exclude dist/ or build/ — the built api/api-server/ bundle is needed by Vercel
